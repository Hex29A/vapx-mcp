# Camera passwords — referenced as ${VAR} in cameras.yaml
# Copy this file to .env and fill in real values.

# FRONT_DOOR_PASS=your_password_here
# BACKYARD_PASS=your_password_here

# Bearer token required by the HTTP transports (sse, streamable-http)
# Generate with: openssl rand -hex 32
# VAPX_MCP_TOKEN=
